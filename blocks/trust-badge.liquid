{%- doc -%}
  Renders a single trust badge: an icon with a short text and an optional link.

  @param {string} [icon]
  @param {string} text
  @param {string} [link]
{%- enddoc -%}

{%-  liquid
  assign icon = block.settings.icon
  assign text = block.settings.text
  assign link = block.settings.link
-%}

<div class="trust-badge" {{  block.shopify_attributes }}>
  {%- if link != blank -%}<a href="{{ link }}" class="trust-badge__link">{%- endif -%}

  {%- if icon != blank -%}
    <svg
      class="trust-badge__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      width="20"
      height="20"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      {% render 'icon', icon: icon %}
    </svg>
  {%- endif -%}

  <span class="trust-badge__text">{{ text }}</span>

  {%- if link != blank -%}</a>{%- endif -%}
  
</div>

{% stylesheet %}
  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .trust-badge__icon {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }
  .trust-badge__link {
    display: inherit;
    align-items: inherit;
    gap: inherit;
    color: inherit;
    text-decoration: none;
  }
{% endstylesheet %}


