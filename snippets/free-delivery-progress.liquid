{%- doc -%}
  Renders a free delivery progress message for the cart.
  The threshold and wording come from theme settings.
{%- enddoc -%}

{%- liquid
  assign threshold = settings.free_delivery_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
-%}

{%- if cart.total_price > 0 and threshold > 0 -%}
  <p class="free-delivery-progress" role="status">
    {%- if remaining > 0 -%}
      {%- assign amount = remaining | money -%}
      {{ settings.free_delivery_progress_text | escape | replace: '[amount]', amount }}
    {%- else -%}
      {{ settings.free_delivery_unlocked_text | escape }}
    {%- endif -%}
  </p>
{%- endif -%}

{% stylesheet %}
  .free-delivery-progress {
    margin: 0;
    text-align: center;
  }
{% endstylesheet %}